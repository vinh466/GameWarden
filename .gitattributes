* text=auto

*.cs     text eol=crlf
*.csproj text eol=crlf
*.sln    text eol=crlf
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.md     text eol=lf
*.json   text eol=lf
*.excalidraw text eol=lf

# The panel's formatter (oxfmt) expects LF, also on Windows checkouts.
*.ts     text eol=lf
*.tsx    text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.svg    text eol=lf
*.yml    text eol=lf

*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary
