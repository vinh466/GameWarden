      "boundElements": [],
      "updated": 1761523200000,
      "link": null,
      "locked": false,
      "text": "Crash policy (defaults, per instance)\n• back-off 10 s, 30 s, 60 s, 120 s, 300 s\n• 5 restarts within 30 min → Faulted\n• counter resets after 30 min in Running\n   or on a manual start\n• every crash → instance.crashed\n   (Discord + activity, last 50 console lines)",
      "originalText": "Crash policy (defaults, per instance)\n• back-off 10 s, 30 s, 60 s, 120 s, 300 s\n• 5 restarts within 30 min → Faulted\n• counter resets after 30 min in Running\n   or on a manual start\n• every crash → instance.crashed\n   (Discord + activity, last 50 console lines)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "n1",
      "lineHeight": 1.25,
      "autoResize": true,
