      "isDeleted": false,
      "boundElements": [],
      "updated": 1761523200000,
      "link": null,
      "locked": false,
      "text": "Busy (dashed arrows)\nAn exclusive job holds the instance lock. Jobs that\nneed the server stopped stop it first (e.g. update).\nThe previous state is restored when the job ends.",
      "originalText": "Busy (dashed arrows)\nAn exclusive job holds the instance lock. Jobs that\nneed the server stopped stop it first (e.g. update).\nThe previous state is restored when the job ends.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "n3",
      "lineHeight": 1.25,
      "autoResize": true,
