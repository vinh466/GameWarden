    {
      "id": "03-t-127",
      "type": "text",
      "x": 800,
      "y": 786,
      "width": 630,
      "height": 88,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
