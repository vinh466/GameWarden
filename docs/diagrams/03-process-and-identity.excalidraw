      "seed": 1126806167,
      "version": 1,
      "versionNonce": 1142024188,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761523200000,
      "link": null,
      "locked": false,
      "text": "Write access (ADR-0009): only C:\\GameWarden\\instances\\<id>\\{server, config, data, mods, logs},\ntools\\steamcmd and its own profile. Read-only: adapters. No access: db, secrets, keys, backups.\n\nAll instances share this identity, so a mod in one instance can change another instance's files.\nAccepted for friends-only use; per-instance users would need a new ADR.",
      "originalText": "Write access (ADR-0009): only C:\\GameWarden\\instances\\<id>\\{server, config, data, mods, logs},\ntools\\steamcmd and its own profile. Read-only: adapters. No access: db, secrets, keys, backups.\n\nAll instances share this identity, so a mod in one instance can change another instance's files.\nAccepted for friends-only use; per-instance users would need a new ADR.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "writes",
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 12
    },
