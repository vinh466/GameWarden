    {
      "id": "03-t-116",
      "type": "text",
      "x": 80,
      "y": 334,
      "width": 432,
      "height": 193,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
