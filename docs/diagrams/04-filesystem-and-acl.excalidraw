      "link": null,
      "locked": false
    },
    {
      "id": "04-t-95",
      "type": "text",
      "x": 1190,
      "y": 700,
      "width": 383,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1398379239,
      "version": 1,
      "versionNonce": 1458253265,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761523200000,
      "link": null,
      "locked": false,
      "text": "Why: default ACL of C:\\ (icacls, measured 2026-10-27)\nAuthenticated Users:(OI)(CI)(IO)(M)\n→ every new folder under C:\\ is writable by any local user,\n   including gamewarden-run and the mods running as it.",
      "originalText": "Why: default ACL of C:\\ (icacls, measured 2026-10-27)\nAuthenticated Users:(OI)(CI)(IO)(M)\n→ every new folder under C:\\ is writable by any local user,\n   including gamewarden-run and the mods running as it.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "why",
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 12
    },
    {
      "id": "recheck",
      "type": "rectangle",
      "x": 1180,
      "y": 850,
      "width": 540,
      "height": 90,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1124373449,
      "version": 1,
      "versionNonce": 1276546048,
      "isDeleted": false,
