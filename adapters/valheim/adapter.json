{
  "schemaVersion": 1,
  "id": "valheim",
  "name": "Valheim",
  "version": "0.5.1",
  "level": "L3",
  "source": { "type": "steamcmd", "appId": 896660 },
  "launch": {
    "exe": "{paths.server}\\valheim_server.exe",
    "args": [
      "-nographics", "-batchmode",
      "-name", "{settings.serverName}",
      "-port", "{ports.game}",
      "-world", "{settings.world}",
      "-password", "{secrets.password}",
      "-savedir", "{paths.data}",
      "-saveinterval", "{settings.saveInterval}",
      "-logFile", "{paths.logs}\\valheim_server.log"
    ],
    "workingDir": "{paths.server}",
    "env": { "SteamAppId": "892970" },
    "consoleLogFile": "{paths.logs}\\valheim_server.log"
  },
  "ports": [
    { "name": "game", "protocol": "udp", "default": 2456 },
    { "name": "query", "protocol": "udp", "offset": { "of": "game", "by": 1 } }
  ],
  "integration": {
    "provider": "valheim-console",
    "transport": "console",
    "label": { "en": "Valheim players", "vi": "Người chơi Valheim" },
    "events": [
      { "event": "joining", "pattern": "Got connection SteamID (?<id>\\d+?)\\D*?$" },
      { "event": "joining", "pattern": "PlayFab socket with remote ID .*? received local Platform ID (?<id>\\w+?_\\d+?)$" },
      { "event": "online", "pattern": "Got character ZDOID from (?<name>.+?) : (?<zdo>[\\d-]+?)\\D*?:\\d+?\\D*?$" },
      { "event": "offline", "pattern": "Peer (?<key>\\d+?) has wrong password" },
      { "event": "offline", "pattern": "Closing socket (?<key>\\d+?)\\D*?$" },
      { "event": "offline", "pattern": "Destroying abandoned non persistent zdo (?<key>[\\d-]+?):.*$" },
      { "event": "offline", "pattern": "Disconnect: The client \\((?<key>\\w+?_\\d+?)\\)" },
      { "event": "reset", "pattern": "Game server connected" },
      { "event": "reset", "pattern": "Opened Steam server" }
    ]
  },
  "readiness": { "type": "logRegex", "source": "stdout", "pattern": "Game server connected|Opened Steam server", "timeoutSec": 300 },
  "stop": { "method": "ctrl-c", "timeoutSec": 60 },
  "backup": { "paths": ["{paths.data}"], "mode": "stop" },
  "players": { "type": "a2s", "port": "{ports.query}" },
  "prerequisites": ["vcredist-x64"],
  "resources": {
    "min": { "cpuCores": 2, "ramMb": 2048, "diskMb": 2000 },
    "recommended": { "cpuCores": 4, "ramMb": 4096, "diskMb": 4000 }
  },
  "mods": {
    "loader": "bepinex",
    "loaderPackage": "denikson-BepInExPack_Valheim",
    "sources": [{ "type": "thunderstore", "community": "valheim" }]
  }
}
