<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>GameWarden.Core</RootNamespace>
    <!-- Discord.Net builds the guild's PreferredCulture (for example en-US) in SocketGuild.Update. Invariant
         globalization throws CultureNotFoundException there, which aborts the guild update and leaves the bot
         without channels (docs/20 §2). Do not turn this back on while the Operations Agent runs in Core. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The API's OpenAPI document is written at build time for the panel's generated client (docs/11 §9). -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\..\..\panel\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name gamewarden-api --openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <!-- r2modman profile codes carry export.r2x, a YAML file (docs/13 §3). -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameWarden.Contracts\GameWarden.Contracts.csproj" />
    <!-- Copies GameWarden.Runner.exe next to Core; the default RunnerPath in development. -->
    <ProjectReference Include="..\GameWarden.Runner\GameWarden.Runner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\adapters\**\*" LinkBase="adapters-builtin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\runbooks\**\*" LinkBase="runbooks" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameWarden.Core.Tests" />
  </ItemGroup>

</Project>
