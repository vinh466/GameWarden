<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Exercises both adapter sets (and Setup's planning logic); still runs on Linux (ADR-0016). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="GameWarden.Tests" />
    <Compile Include="..\Shared\TestPlatform.cs" Link="Shared\TestPlatform.cs" />
    <!-- The Palworld template S-P1 captured, for the ue-struct-ini round trip (docs/14 §3). -->
    <None Include="..\..\spikes\s-p1-palworld\DefaultPalWorldSettings-1.0.5.102999.ini"
          Link="TestData\PalworldTemplate-1.0.5.ini"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameWarden.Core\GameWarden.Core.csproj" />
    <ProjectReference Include="..\..\src\GameWarden.Runner\GameWarden.Runner.csproj" />
    <ProjectReference Include="..\FakeGame\FakeGame.csproj" />
    <!-- Setup's planning logic only; Setup itself needs admin and is tested on the VM (ADR-0012). -->
    <ProjectReference Include="..\..\src\GameWarden.Setup\GameWarden.Setup.csproj" Aliases="setup" />
    <!-- The CLI's mods commands, run against the test Core (docs/13 §4.11). -->
    <ProjectReference Include="..\..\src\GameWarden.Cli\GameWarden.Cli.csproj" Aliases="cli" />
  </ItemGroup>

</Project>
