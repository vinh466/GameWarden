<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Exercises both adapter sets (and Setup's planning logic); still runs on Linux (ADR-0016). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="GameWarden.Tests" />
    <Compile Include="..\Shared\TestPlatform.cs" Link="Shared\TestPlatform.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameWarden.Contracts\GameWarden.Contracts.csproj" />
    <ProjectReference Include="..\..\src\GameWarden.Runner\GameWarden.Runner.csproj" />
    <ProjectReference Include="..\FakeGame\FakeGame.csproj" />
  </ItemGroup>

</Project>
